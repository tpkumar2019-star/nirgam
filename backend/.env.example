PROJECT_NAME="Urban Flood Nowcasting System"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="demonstration"

# Spatial bounding box
BBOX_LAT_MIN=12.9250
BBOX_LAT_MAX=12.9450
BBOX_LON_MIN=77.5850
BBOX_LON_MAX=77.6100

# Safety thresholds (cm)
DEPTH_THRESHOLD_LOW=5.0
DEPTH_THRESHOLD_MODERATE=15.0
DEPTH_THRESHOLD_HIGH=30.0
DEPTH_THRESHOLD_SEVERE=50.0
